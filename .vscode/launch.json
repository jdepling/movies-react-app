{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Frontend (npm run dev)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\npm.cmd",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s*(http://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Launch Backend (Development + Swagger)",
      "type": "coreclr",
      "request": "launch",
      "runtimeExecutable": "C:\\Program Files\\dotnet\\dotnet.exe",
      "program": "${workspaceFolder}/backend/bin/Debug/net8.0/MovieApp.Api.dll",
      "justMyCode": false,
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "preLaunchTask": "build-backend",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+|http://\\S+)",
        "uriFormat": "%s/swagger/index.html"
      }
    }
  ],
  "compounds": [
    {
      "name": "Frontend + Backend",
      "configurations": [
        "Run Frontend (npm run dev)",
        "Launch Backend (Development + Swagger)"
      ]
    }
  ]
}